# =============================================================================
# Pipeline de Dados da Saude Suplementar - variaveis de ambiente (exemplo)
# Copie este arquivo para ".env" e preencha com valores REAIS do seu ambiente.
# NUNCA versione o arquivo ".env" (ja esta no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server - conexao de CARGA (ETL). Usuario com permissao de escrita nos
# schemas stg/dim/fact/aud/rej (ver sql/security/02_create_logins.sql).
# -----------------------------------------------------------------------------
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=saude_suplementar
SQLSERVER_USER=etl_writer
SQLSERVER_PASSWORD=uma_senha_segura_trocar
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUST_CERTIFICATE=yes
SQLSERVER_ENCRYPT=yes
SQLSERVER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# SQL Server - conexao de LEITURA (Streamlit). Usuario somente leitura,
# restrito as views do schema "rpt" (ver sql/security/02_create_logins.sql).
# -----------------------------------------------------------------------------
SQLSERVER_READONLY_USER=dashboard_reader
SQLSERVER_READONLY_PASSWORD=outra_senha_segura_trocar

# -----------------------------------------------------------------------------
# Administrador (usado apenas por scripts de setup local / docker init - NUNCA
# usado pela aplicacao ou pelo pipeline em tempo de execucao).
# -----------------------------------------------------------------------------
SQLSERVER_SA_PASSWORD=Senha_Fictícia_Nao_Usar_Em_Producao#2026

# -----------------------------------------------------------------------------
# Fontes de dados publicas
# -----------------------------------------------------------------------------
# ANS - beneficiarios (dados consolidados). URL real confirmada, mensal, por UF.
ANS_BENEFICIARIOS_BASE_URL=https://dadosabertos.ans.gov.br/FTP/PDA/informacoes_consolidadas_de_beneficiarios-024
# UFs incluidas por padrao na extracao (27 = todas as unidades da federacao + XX = nao identificado/exterior)
ANS_BENEFICIARIOS_UFS=AC,AL,AM,AP,BA,CE,DF,ES,GO,MA,MG,MS,MT,PA,PB,PE,PI,PR,RJ,RN,RO,RR,RS,SC,SE,SP,TO,XX

# ANS - operadoras ativas. URL real confirmada (snapshot unico, sem historico por competencia).
ANS_OPERADORAS_URL=https://dadosabertos.ans.gov.br/FTP/PDA/operadoras_de_plano_de_saude_ativas/Relatorio_cadop.csv

# CNES - estabelecimentos. NAO existe URL estavel de download direto (portal
# exige selecao dinamica de UF/competencia). Informe uma URL valida encontrada
# manualmente OU deposite o(s) arquivo(s) em data/raw/cnes/incoming/.
CNES_DOWNLOAD_URL=
CNES_MANUAL_INPUT_DIR=data/raw/cnes/incoming

# -----------------------------------------------------------------------------
# Diretorios de dados (relativos a raiz do projeto)
# -----------------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_TRUSTED_DIR=data/trusted
DATA_ANALYTICS_DIR=data/analytics
DATA_REJECTED_DIR=data/rejected

# -----------------------------------------------------------------------------
# Aplicacao / execucao
# -----------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json
PIPELINE_NAME=pipeline_saude_suplementar
DEFAULT_REFERENCE_PERIOD=2024-12
SQL_QUERY_ROW_LIMIT=200000

# -----------------------------------------------------------------------------
# Streamlit
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_CACHE_TTL_SECONDS=300
